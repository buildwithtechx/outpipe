---
import '../styles/global.css';
import outpipeMark from '@outpipe/shared/outpipe.svg?url';
import { publicSiteUrl } from '@outpipe/shared';

const siteUrl = publicSiteUrl(import.meta.env.DEV);

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Outpipe Share — Zero-Knowledge Secret Sharing',
  description = 'Share end-to-end encrypted passwords, credentials, and tokens with burn-on-read and custom expiry. The decryption key never leaves your browser.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href={outpipeMark} />
  </head>
  <body>
    <header class="product-header">
      <div class="product-header-inner">
        <a href={siteUrl} class="product-brand" aria-label="Outpipe home">
          <img src={outpipeMark} alt="" width="40" height="40" />
          <span>Outpipe</span>
          <span class="product-label">Secret sharing</span>
        </a>
        <nav class="product-nav" aria-label="Product navigation">
          <a href="/">Share a secret</a>
          <a href={`${siteUrl}/docs`}>Docs</a>
          <a href={`${siteUrl}/login`}>Sign in</a>
        </nav>
      </div>
    </header>

    <main class="main-content">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="product-footer">
      <p>Encrypted in your browser. Shared on your terms.</p>
      <nav class="product-footer-links" aria-label="Footer navigation">
        <a href={siteUrl}>Outpipe</a>
        <a href={`${siteUrl}/privacy`}>Privacy</a>
        <a href={`${siteUrl}/contact`}>Support</a>
      </nav>
    </footer>
  </body>
</html>
