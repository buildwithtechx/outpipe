---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Outpipe Share — Zero-Knowledge Secret Sharing',
  description = 'Share end-to-end encrypted passwords, credentials, and tokens with burn-on-read and custom expiry. The decryption key never leaves your browser.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#090d16" />
  </head>
  <body>
    <header class="header">
      <div class="container header-content">
        <a href="/" class="logo-badge">
          <div class="logo-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <span>Outpipe Share</span>
        </a>
        <div class="badge-tag">Zero-Knowledge AES-GCM</div>
      </div>
    </header>

    <main class="main-content">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="footer">
      <div class="container">
        <p>Client-side AES-256-GCM encryption. The decryption key stays in the URL hash fragment and is never sent to the server.</p>
        <p style="margin-top: 0.5rem; font-size: 0.8125rem;">
          Built with <a href="https://outpipe.dev" style="color: #60a5fa; text-decoration: underline;">Outpipe</a>
        </p>
      </div>
    </footer>
  </body>
</html>
