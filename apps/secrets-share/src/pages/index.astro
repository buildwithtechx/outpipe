---
import BaseLayout from '../layouts/base-layout.astro';
import { ShareComposer } from '../components/share-composer';
---

<BaseLayout>
  <section class="product-intro" aria-labelledby="share-heading">
    <p class="product-eyebrow">Outpipe secret sharing</p>
    <h1 id="share-heading">Share a secret.<br />Keep control.</h1>
    <p>Send sensitive information with an encrypted link that expires on your terms. Anyone with the link can unlock it; add a passphrase for extra protection.</p>
  </section>
  <ShareComposer client:load />
</BaseLayout>
