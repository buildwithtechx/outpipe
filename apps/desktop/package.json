{
  "name": "@outpipe/desktop",
  "productName": "Outpipe",
  "version": "0.1.0",
  "private": true,
  "description": "Outpipe standalone desktop application",
  "author": "TechX",
  "type": "module",
  "scripts": {
    "dev": "npm run bundle:cli && tauri dev",
    "build": "npm run bundle:cli && tauri build",
    "bundle:cli": "go build -o src-tauri/resources/outpipe ../../cmd/cli",
    "typecheck": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
