# App Configuration
VITE_OUTPIPE_APP_TITLE=Outpipe
VITE_OUTPIPE_SITE_URL=http://localhost:3000
VITE_OUTPIPE_DOCS_URL=http://localhost:4323
VITE_OUTPIPE_STATUS_URL=http://localhost:4322
VITE_OUTPIPE_SERVER_URL=http://localhost:8080
VITE_OUTPIPE_API_BASE_URL=http://localhost:8080
OUTPIPE_SERVER_URL=http://localhost:8080

# UI & Layout
VITE_UNIFIED_SIDEBAR=true
VITE_SHARE_PUBLIC_ORIGIN=http://localhost:4324

# PostHog Telemetry
VITE_OUTPIPE_POSTHOG_HOST=https://us.i.posthog.com
VITE_OUTPIPE_POSTHOG_KEY=phc_your_posthog_key_here

# AI Troubleshooting Assistant (Client provider override)
# Default is handled securely by the Go server.
VITE_DEFAULT_AGENT_PROVIDER=mock
VITE_AGENT_MODEL=outpipe-heuristic-engine-v1

# Dashboard Read-Through Caching Options
DASHBOARD_REDIS_CACHE_TTL_MS=5000
AUTH_SESSION_CACHE_TTL_MS=30000
AUTH_SESSION_CACHE_MAX_ENTRIES=1000
