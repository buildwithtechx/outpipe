{
  "name": "@outpipe/angular",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "build": "tsup && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly --noEmit false",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "description": "Angular integration for Outpipe",
  "files": ["dist"],
  "dependencies": {
    "@outpipe/sdk": "0.1.0"
  },
  "peerDependencies": {
    "@angular/common": ">=17",
    "@angular/core": ">=17"
  },
  "devDependencies": {
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "rxjs": "^7.8.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
