# Runtime Environment
OUTPIPE_ENV=development

# Database Credentials
OUTPIPE_DATABASE_URL=postgresql://outpipe:outpipe@localhost:5432/outpipe

# Redis Credentials
OUTPIPE_REDIS_PASSWORD=

# Internal Service Authentication
OUTPIPE_INTERNAL_API_SECRET=generate_a_secure_random_string_here

# Session & Secret Encryption
OUTPIPE_AUTH_ENCRYPTION_KEY=replace_with_16_24_or_32_byte_key
OUTPIPE_CHALLENGE_DNS_CREDENTIAL=

# OAuth Provider Credentials
OUTPIPE_GITHUB_CLIENT_ID=your_github_client_id
OUTPIPE_GITHUB_CLIENT_SECRET=your_github_client_secret
OUTPIPE_GOOGLE_CLIENT_ID=your_google_client_id
OUTPIPE_GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Delivery Credentials
OUTPIPE_ZEPTO_API_KEY=your_zepto_api_key

# Billing Provider Credentials
OUTPIPE_POLAR_ACCESS_TOKEN=polar_oat_xxxxxxxxxxxxxxxxx
OUTPIPE_POLAR_WEBHOOK_SECRET=your_polar_webhook_secret_here
OUTPIPE_PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
OUTPIPE_BILLING_WEBHOOK_SECRET=your_billing_webhook_secret_here

# Analytics Credentials
OUTPIPE_TINYBIRD_TOKEN=
OUTPIPE_CLICKHOUSE_PASSWORD=
TINYBIRD_INGEST_TOKEN=your_scoped_tinybird_append_token
TINYBIRD_TUNNEL_INGEST_TOKEN=
TINYBIRD_QUERY_TOKEN=your_scoped_tinybird_read_token

# AI Provider API Keys
OPENAI_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=

# Standalone CLI Credentials
OUTPIPE_API_KEY=replace_with_issued_outpipe_api_key
OUTPIPE_TOKEN=replace_with_short_lived_secrets_machine_token
OUTPIPE_AGENT_TOKEN=replace_with_registered_outpipe_agent_token
OUTPIPE_PASSWORD=replace_with_your_tunnel_access_password
