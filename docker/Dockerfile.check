# syntax=docker/dockerfile:1

# Build one-shot domain and relay readiness checks.
FROM golang:1.25-alpine AS build

WORKDIR /workspace

COPY go.mod go.sum ./
RUN go mod download

COPY . .
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -ldflags="-s -w -X main.version=${VERSION}" -o /out/check ./cmd/check

# Run this image from cron, CI, or an orchestrator health workflow.
FROM alpine:3.22

RUN addgroup -S outpipe && adduser -S -G outpipe outpipe

WORKDIR /app
COPY --from=build /out/check /app/check

USER outpipe

ENTRYPOINT ["/app/check"]
