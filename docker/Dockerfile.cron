# syntax=docker/dockerfile:1

# Build scheduled maintenance jobs.
FROM golang:1.26.9-alpine AS build

WORKDIR /workspace

COPY go.mod go.sum ./
RUN go mod download

COPY . .
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -ldflags="-s -w -X main.version=${VERSION}" -o /out/cron ./cmd/cron

# Run this image from a scheduler, not as a public service.
FROM alpine:3.22

RUN apk --no-cache add ca-certificates tzdata postgresql16-client && \
    addgroup -S outpipe && adduser -S -G outpipe outpipe && \
    mkdir -p /var/backups/outpipe && chown -R outpipe:outpipe /var/backups/outpipe

WORKDIR /app
COPY --from=build /out/cron /app/cron
COPY --from=build /workspace/configs /app/configs

USER outpipe

ENTRYPOINT ["/app/cron"]
