<!doctype html>
<html lang="en">
  <body style="margin: 0; background: #000000; color: #f7f7fb; font-family: Arial, sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="padding: 40px 16px; background: #000000">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; background: #08090f; border: 1px solid #24283a; border-radius: 16px;">
            <tr>
              <td style="padding: 32px">
                <h1 style="margin: 0 0 16px; font-size: 22px;">Confirm your subscription</h1>
                <p style="margin: 0 0 16px; font-size: 14px; color: #b9bdd0;">You asked to receive status updates for <strong>{{ .PageTitle }}</strong>. Confirm within 24 hours to start receiving incident notifications.</p>
                <p style="margin: 0 0 24px;"><a href="{{ .ConfirmURL }}" style="display: inline-block; padding: 12px 24px; background: #4f46e5; color: #ffffff; text-decoration: none; border-radius: 8px; font-size: 14px;">Confirm subscription</a></p>
                <p style="margin: 0; font-size: 12px; color: #777b8d;">If you did not request this, you can safely ignore this email.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
