<!doctype html>
<html lang="en">
  <body style="margin: 0; background: #000000; color: #f7f7fb; font-family: Arial, sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="padding: 40px 16px; background: #000000">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; background: #08090f; border: 1px solid #24283a; border-radius: 16px;">
            <tr>
              <td style="padding: 32px">
                <p style="margin: 0 0 8px; font-size: 12px; color: #777b8d;">{{ .PageTitle }} &mdash; {{ .Status }}</p>
                <h1 style="margin: 0 0 16px; font-size: 22px;">{{ .IncidentTitle }}</h1>
                <p style="margin: 0 0 24px; font-size: 14px; color: #b9bdd0;">{{ .Message }}</p>
                <p style="margin: 0; font-size: 12px; color: #777b8d;"><a href="{{ .UnsubscribeURL }}" style="color: #777b8d;">Unsubscribe from these updates</a></p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
