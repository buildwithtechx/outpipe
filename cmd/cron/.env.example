# Runtime Environment
OUTPIPE_ENV=development

# Database Credentials
OUTPIPE_DATABASE_URL=postgresql://outpipe:outpipe@localhost:5432/outpipe

# Redis Credentials
OUTPIPE_REDIS_PASSWORD=

# Internal Service Authentication
OUTPIPE_INTERNAL_API_SECRET=generate_a_secure_random_string_here

# Session & Secret Encryption
# Exactly 32 characters as a raw string: use `openssl rand -hex 16`.
OUTPIPE_AUTH_ENCRYPTION_KEY=replace_with_a_32_character_string_value
OUTPIPE_CHALLENGE_DNS_CREDENTIAL=

# OAuth Provider Credentials
OUTPIPE_GOOGLE_CLIENT_ID=
OUTPIPE_GOOGLE_CLIENT_SECRET=
OUTPIPE_GITHUB_CLIENT_ID=
OUTPIPE_GITHUB_CLIENT_SECRET=

# Email Delivery Credentials
OUTPIPE_ZEPTO_API_KEY=

# Analytics Credentials
OUTPIPE_TINYBIRD_TOKEN=
OUTPIPE_CLICKHOUSE_PASSWORD=
