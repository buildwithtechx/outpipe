# Scheduled maintenance worker
OUTPIPE_APP_NAME=outpipe-cron
OUTPIPE_ENV=development
OUTPIPE_LOG_LEVEL=info
OUTPIPE_SHUTDOWN_TIMEOUT=10s
OUTPIPE_PORT=8080
OUTPIPE_INTERNAL_LISTEN_ADDRESS=127.0.0.1:9090
OUTPIPE_PUBLIC_API_URL=http://localhost:8080
OUTPIPE_DASHBOARD_URL=http://localhost:3000
OUTPIPE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
OUTPIPE_CORS_ORIGIN=http://localhost:3000
OUTPIPE_ACME_EMAIL=owner@example.com
OUTPIPE_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
OUTPIPE_CERTIFICATE_CACHE_DIR=.data/acme
OUTPIPE_REQUIRE_TLS=false
OUTPIPE_TLS_CERT_FILE=data/tls/localhost.crt
OUTPIPE_TLS_KEY_FILE=data/tls/localhost.key
# Email delivery queue
OUTPIPE_MAIL_FROM=noreply@localhost
OUTPIPE_SUPPORT_EMAIL=support@outpipe.dev
OUTPIPE_ZEPTO_URL=https://api.zeptomail.com/v1.1/email
OUTPIPE_ZEPTO_API_KEY=

# Shared persistence
OUTPIPE_DATABASE_URL=postgresql://outpipe:outpipe@localhost:5432/outpipe
OUTPIPE_DATABASE_MAX_CONNS=5
OUTPIPE_DB_CONN_MAX_LIFETIME=30m
OUTPIPE_DB_CONN_MAX_IDLE_TIME=5m
OUTPIPE_REDIS_HOST=localhost
OUTPIPE_REDIS_PORT=6379
OUTPIPE_REDIS_PASSWORD=
OUTPIPE_REDIS_DB=0

# Private API communication
OUTPIPE_INTERNAL_API_URL=http://127.0.0.1:9090
OUTPIPE_INTERNAL_API_SECRET=generate_a_secure_random_string_here

# Backups
OUTPIPE_BACKUP_DIRECTORY=data/backups
OUTPIPE_BACKUP_KEEP=7
OUTPIPE_CRON_METRICS=0
OUTPIPE_BACKUP_PG_DUMP_PATH=pg_dump
OUTPIPE_BACKUP_PG_RESTORE_PATH=pg_restore
