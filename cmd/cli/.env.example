# Advanced CLI overrides; hosted users can run outpipe login without this file
OUTPIPE_API_URL=https://api.outpipe.dev
OUTPIPE_RELAY_URL=wss://relay.outpipe.app/v1/connect
OUTPIPE_DOMAIN=outpipe.app
OUTPIPE_API_KEY=replace_with_issued_outpipe_api_key
# Short-lived machine token: secrets:read for secrets, tunnels:write for tunnels
OUTPIPE_TOKEN=replace_with_short_lived_secrets_machine_token
OUTPIPE_AGENT_TOKEN=replace_with_registered_outpipe_agent_token
OUTPIPE_PASSWORD=replace_with_your_tunnel_access_password
# Optional override of the OS user configuration directory
OUTPIPE_CONFIG_PATH=
