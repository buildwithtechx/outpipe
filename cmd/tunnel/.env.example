# Public relay
OUTPIPE_PORT=8081
OUTPIPE_APP_NAME=outpipe-relay
OUTPIPE_ENV=development
OUTPIPE_RELAY_ID=relay-local

OUTPIPE_REQUIRE_TLS=false
OUTPIPE_TLS_CERT_FILE=
OUTPIPE_TLS_KEY_FILE=
OUTPIPE_TUNNEL_DOMAIN=outpipe.localhost
OUTPIPE_TUNNEL_TOKEN_TTL=24h
OUTPIPE_TUNNEL_MAX_CONNECTIONS=1000
OUTPIPE_TUNNEL_MAX_TUNNELS=1000
OUTPIPE_TUNNEL_MAX_BYTES=0
OUTPIPE_TUNNEL_MAX_BANDWIDTH_BYTES=0
OUTPIPE_TUNNEL_HEARTBEAT_INTERVAL=20s
OUTPIPE_TUNNEL_READ_TIMEOUT=90s
OUTPIPE_TUNNEL_MAX_FRAME_BYTES=16777216
OUTPIPE_TUNNEL_DRAIN_TIMEOUT=10s

# Redis coordination with the API and workers
OUTPIPE_REDIS_HOST=localhost
OUTPIPE_REDIS_PORT=6379
OUTPIPE_REDIS_PASSWORD=
OUTPIPE_REDIS_DB=0

# Private API communication
OUTPIPE_INTERNAL_API_URL=http://127.0.0.1:9090
OUTPIPE_INTERNAL_API_SECRET=generate_a_secure_random_string_here