# Public relay
OUTPIPE_PORT=8081
OUTPIPE_APP_NAME=outpipe-relay
OUTPIPE_ENV=development
OUTPIPE_RELAY_ID=relay-local

# When Outpipe PaaS or another reverse proxy terminates HTTPS, leave this false.
# Set true only when this relay is directly exposed on the public network.
OUTPIPE_REQUIRE_TLS=false
OUTPIPE_TLS_CERT_FILE=
OUTPIPE_TLS_KEY_FILE=

# Use tunnel.localhost locally. In production configure one wildcard DNS record
# for *.tunnel.outpipe.dev and point TUNNEL_DOMAIN at that domain.
OUTPIPE_DOMAIN=tunnel.localhost
OUTPIPE_REQUIRE_TLS=false
OUTPIPE_TOKEN_TTL=24h
OUTPIPE_MAX_CONNECTIONS=1000
OUTPIPE_MAX_TUNNELS=1000
OUTPIPE_MAX_BYTES=0
OUTPIPE_MAX_BANDWIDTH_BYTES=0
OUTPIPE_HEARTBEAT_INTERVAL=20s
OUTPIPE_READ_TIMEOUT=90s
OUTPIPE_MAX_FRAME_BYTES=16777216
OUTPIPE_DRAIN_TIMEOUT=10s

# Redis coordination with the API and workers
OUTPIPE_REDIS_HOST=localhost
OUTPIPE_REDIS_PORT=6379
OUTPIPE_REDIS_PASSWORD=
OUTPIPE_REDIS_DB=0

# Private API communication
OUTPIPE_INTERNAL_API_URL=http://localhost:8080
OUTPIPE_INTERNAL_API_SECRET=generate_a_secure_random_string_here
