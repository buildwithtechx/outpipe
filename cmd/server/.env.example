# Control-plane API
OUTPIPE_PORT=8080
OUTPIPE_APP_NAME=outpipe-api
OUTPIPE_ENV=development
OUTPIPE_PUBLIC_API_URL=http://localhost:8080
OUTPIPE_DASHBOARD_URL=http://localhost:3000
# Set true in production and provide a certificate covering the API hostname.
OUTPIPE_ACME_EMAIL=
OUTPIPE_ACME_DIRECTORY=
OUTPIPE_CERTIFICATE_CACHE_DIR=.data/acme
OUTPIPE_REQUIRE_TLS=false
OUTPIPE_TLS_CERT_FILE=
OUTPIPE_TLS_KEY_FILE=

# PostgreSQL
OUTPIPE_DATABASE_URL=postgresql://outpipe:outpipe@localhost:5432/outpipe
OUTPIPE_DATABASE_MAX_CONNS=25

# Redis
OUTPIPE_REDIS_HOST=localhost
OUTPIPE_REDIS_PORT=6379
OUTPIPE_REDIS_PASSWORD=
OUTPIPE_REDIS_DB=0

# Server-to-server authentication
OUTPIPE_INTERNAL_API_SECRET=generate_a_secure_random_string_here

# OAuth providers
OUTPIPE_GOOGLE_CLIENT_ID=your_google_client_id
OUTPIPE_GOOGLE_CLIENT_SECRET=your_google_client_secret
OUTPIPE_AUTH_ENCRYPTION_KEY=replace_with_16_24_or_32_byte_key
OUTPIPE_INVITATION_TTL=168h
OUTPIPE_OAUTH_STATE_TTL=10m
OUTPIPE_GITHUB_CLIENT_ID=your_github_client_id
OUTPIPE_GITHUB_CLIENT_SECRET=your_github_client_secret

# Zepto Mail
OUTPIPE_MAIL_FROM=you@example.com
OUTPIPE_ZEPTO_URL=https://api.zeptomail.com/v1.1/email
OUTPIPE_ZEPTO_API_KEY=your_zepto_api_key

# Billing
OUTPIPE_POLAR_SERVER=sandbox
OUTPIPE_POLAR_ACCESS_TOKEN=polar_oat_xxxxxxxxxxxxxxxxx
OUTPIPE_POLAR_WEBHOOK_SECRET=your_polar_webhook_secret_here
OUTPIPE_PAYSTACK_BASE_URL=https://api.paystack.co
OUTPIPE_PAYSTACK_SECRET_KEY=paystack_secret_key
OUTPIPE_BILLING_GRACE_PERIOD=72h
